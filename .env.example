# Copy to .env (gitignored) and fill in. Never commit real values.
# Node 22.12+ required (node:sqlite).

# HTTP listen
PORT=80
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173

# Login. One user, ADMIN_USER (default "admin"). The password is read from ADMIN_PASSWORD,
# or TERMINAL_PASSWORD for older setups. With neither set nobody can log in.
# Put it in an EnvironmentFile outside the repo (mode 600), not in this file.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Storage
DASHBOARD_DATA_DIR=/opt/pulse/data
DASHBOARD_DB=/opt/pulse/data/telemetry.db
NINEROUTER_DB=/home/youruser/.9router/db/data.sqlite

# Docker
DOCKER_SOCKET=/var/run/docker.sock

# Reachability. Unset hosts are skipped.
REACHABILITY_CHECKER_URL=
PUBLIC_HOST=
TAILSCALE_HOST=

# Service links (read by Vite at build time; rebuild after changing).
# VITE_BASE_DOMAIN=example.com gives https://<sub>.example.com links.
# VITE_SUBDOMAINS maps a service id to its subdomain label; unmapped ids use the id.
VITE_BASE_DOMAIN=
VITE_SUBDOMAINS=novnc=remote
VITE_TAILSCALE_HOST=

# Alerts (optional — empty means rules evaluate but nothing is sent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SILENT=0


# Terminal backend (node-pty). "ssh" (default) runs the OpenSSH client to the
# loopback sshd, so the shell is outside this service's systemd sandbox and sudo
# works. "local" spawns $SHELL directly: faster, but inherits the sandbox.
TERMINAL_MODE=ssh
